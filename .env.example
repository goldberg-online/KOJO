# DIS ONLINE — Doorbell International School
# Motto: Christ is our light

# Database — prefer Supabase Transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=30&sslmode=require"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-long-random-string"
NEXTAUTH_SECRET="replace-with-long-random-string"

# Site URL must be the origin ONLY — no /login and no /api/auth/...
# Local:
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
# Vercel example (use YOUR project URL):
# NEXTAUTH_URL="https://kojo-gamma.vercel.app"
# AUTH_URL="https://kojo-gamma.vercel.app"
AUTH_TRUST_HOST="true"

# SMS
SMS_PROVIDER=mock
SMS_SENDER_ID=DISOnline

# Seed accounts (npm run seed)
SEED_SUPERADMIN_EMAIL="superadmin@dis.edu.gh"
SEED_SUPERADMIN_PASSWORD="ChangeMeStrong1"
SEED_SUPERADMIN_FIRST_NAME="Platform"
SEED_SUPERADMIN_LAST_NAME="Admin"

SEED_ADMIN_EMAIL="admin@dis.edu.gh"
SEED_ADMIN_PASSWORD="ChangeMeStrong2"
SEED_ADMIN_FIRST_NAME="School"
SEED_ADMIN_LAST_NAME="Administrator"

SEED_SCHOOL_NAME="Doorbell International School"
SEED_SCHOOL_CODE="DIS"
SEED_SCHOOL_PHONE="+233200000000"
SEED_SCHOOL_EMAIL="info@dis.edu.gh"
SEED_SCHOOL_ADDRESS="Accra, Ghana"
SEED_ACADEMIC_YEAR="2025/2026"
