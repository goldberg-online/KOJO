# Database — prefer Supabase Transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=30&sslmode=require"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-long-random-string"
NEXTAUTH_SECRET="replace-with-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# SMS
SMS_PROVIDER=mock
SMS_SENDER_ID=DISOnline

